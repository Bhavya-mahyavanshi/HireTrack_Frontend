# Copy to .env.local for local dev. Never commit .env.local itself.
# NEXT_PUBLIC_ prefix is required for any value read in the browser (Next.js
# only exposes prefixed vars client-side; this is a static-export app, so
# every API call happens client-side, meaning every var the app needs must
# carry this prefix).

NEXT_PUBLIC_API_URL=http://localhost:8080
